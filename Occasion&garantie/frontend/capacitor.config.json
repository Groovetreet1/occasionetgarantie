{
  "appId": "com.occasionetgarantie.app",
  "appName": "Occasion & Garantie",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "cleartext": true,
    "allowNavigation": [
      "occasionetgarantie.store",
      "www.occasionetgarantie.store",
      "api.occasionetgarantie.store"
    ]
  },
  "android": {
    "buildOptions": {
      "keystorePath": null,
      "keystoreAlias": null
    }
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#1e293b",
      "androidSplashResourceName": "splash"
    }
  }
}
